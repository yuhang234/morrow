{
  "name": "morrow",
  "private": true,
  "version": "1.0.1",
  "description": "Morrow —— 一次只做一件事，增援未来的自己。本地优先的反拖延应用。",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win",
    "icons": "node scripts/gen-icons.mjs",
    "cap:add": "cap add android",
    "cap:copy": "cap copy android",
    "cap:sync": "cap sync android",
    "android:build": "cap copy android && cd android && ./gradlew assembleDebug",
    "android:release": "cap copy android && cd android && ./gradlew assembleRelease"
  },
  "build": {
    "appId": "com.morrow.app",
    "productName": "Morrow",
    "artifactName": "Morrow-${version}-win-${arch}-setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Morrow"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}